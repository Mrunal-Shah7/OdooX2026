# PostgreSQL connection string (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/peoplepay360?sslmode=require

# Express listen port
PORT=4000

# JWT signing secret for access tokens (pp_at cookie) — unused while auth is stubbed
JWT_SECRET=change-me-to-a-long-random-string

# Public origin of the web app (invite / reset links)
APP_URL=http://localhost:5173

# Resend API key for invite, reset and payslip emails — unused while mailer is stubbed
RESEND_API_KEY=

# From address used by the mailer
MAIL_FROM=PeoplePay360 <noreply@peoplepay360.test>

# Vite — browser calls the API at this origin
VITE_API_URL=http://localhost:4000
