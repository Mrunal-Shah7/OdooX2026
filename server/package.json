{
  "name": "peoplepay360-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../.env dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "node --env-file=../.env ./node_modules/prisma/build/index.js db push",
    "db:seed": "tsx --env-file=../.env src/db/seed.ts",
    "db:migrate": "node --env-file=../.env ./node_modules/prisma/build/index.js migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@react-pdf/renderer": "^4.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "resend": "^4.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3"
  }
}
